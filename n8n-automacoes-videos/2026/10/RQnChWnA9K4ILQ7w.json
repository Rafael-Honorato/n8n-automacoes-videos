    {
      "parameters": {
        "jsCode": "const templates = $('Get row(s)').all().map(item => item.json);\nconst transcript = $('Transcrever (WhisperX)').first().json;\nconst config = $('Configurações (Mock)').first().json;\nconst filename = config.video_key || 'video_original.mp4';\n\nconst dataToSend = config.display_mode === 'segment' ? transcript.segments : transcript.words;\n\n\nreturn templates.map(template => {\n  return {\n    json: {\n      template_name: template.name || 'default',\n      template_json: JSON.stringify(template),\n      transcript_data: JSON.stringify(dataToSend),\n      original_filename: filename\n    }\n  };\n});"
