      "parameters": {
        "jsCode": "const WORDS_PER_GROUP = 3;\nconst MAX_CHARS_PER_LINE = 22;\nconst HIGHLIGHT_COLOR = \"&H00FFFF&\"; // Amarelo no ASS (BGR invertido)\nconst BASE_COLOR = \"&H00FFFFFF&\";   // Branco\n\nconst items = $input.all();\nconst sourceItems = $('Baixar Vídeo Original').all();\nconst results = [];\n\nfunction formatTime(seconds) {\n  const h = Math.floor(seconds / 3600);\n  const m = Math.floor((seconds % 3600) / 60);\n  const s = Math.floor(seconds % 60);\n  const c = Math.round((seconds % 1) * 100);\n  return `${h}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}.${c.toString().padStart(2, '0')}`;\n}\n\nfunction smartBreak(text, maxLen) {\n  if (text.length <= maxLen) return text;\n  const words = text.split(' ');\n  const mid = Math.ceil(words.length / 2);\n  return `${words.slice(0, mid).join(' ')}\\\\N${words.slice(mid).join(' ')}`;\n}\n\n// Aplica cores: primeira palavra do grupo em destaque, resto em branco\nfunction applyHighlight(words) {\n  return words.map((w, idx) => {\n    const color = idx === 0 ? HIGHLIGHT_COLOR : BASE_COLOR;\n    // Tag de estilo inline + palavra + reset de estilo\n    return `{\\\\c${color}\\\\b1}${w.word}{\\\\r}`;\n  }).join(' ');\n}\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const source = sourceItems[i] ?? sourceItems[0];\n\n  if (!source?.binary?.data) {\n    throw new Error('Binário \"data\" não encontrado.');\n  }\n\n  let words = item.json.words;\n  if (!Array.isArray(words) || words.length === 0) {\n    throw new Error('Array \"words\" vazio.');\n  }\n\n  words.sort((a, b) => a.start - b.start);\n\n  // CABEÇALHO ASS COM ESTILO MODERNO\n  let assContent = `[Script Info]\nTitle: Viral Lyrics by n8n\nScriptType: v4.00+\nPlayResX: 1080\nPlayResY: 1920\nWrapStyle: 0\n\n[V4+ Styles]\nFormat: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\nStyle: Default,Roboto,80,&H00FFFFFF,&H000000FF,&H00000000,&H80000000,1,0,0,0,100,100,2,0,1,4,3,2,30,30,200,1\nStyle: Highlight,Roboto,80,&H00FFFF00,&H000000FF,&H00000000,&H80000000,1,0,0,0,100,100,2,0,1,4,3,2,30,30,200,1\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n`;\n\n  for (let j = 0; j < words.length; j += WORDS_PER_GROUP) {\n    const group = words.slice(j, j + WORDS_PER_GROUP);\n    \n    let start = group[0].start;\n    let end = group[group.length - 1].end;\n    if (start >= end) end = start + 0.6;\n\n    const startStr = formatTime(start);\n    const endStr = formatTime(end);\n    \n    const rawText = group.map(w => w.word).join(' ');\n    const brokenText = smartBreak(rawText, MAX_CHARS_PER_LINE);\n    \n    // Aplica destaque colorido\n    const highlightedText = applyHighlight(group);\n    \n    // Adiciona emoji temático baseado no conteúdo (opcional)\n    let emoji = '';\n    const textLower = rawText.toLowerCase();\n    if (textLower.includes('beijo') || textLower.includes('boca')) emoji = '💋 ';\n    else if (textLower.includes('veneno')) emoji = '🐍 ';\n    else if (textLower.includes('cama')) emoji = '🛏️ ';\n    else if (textLower.includes('fogo') || textLower.includes('fogo')) emoji = '🔥 ';\n    \n    const finalText = `${emoji}${highlightedText}`;\n    \n    assContent += `Dialogue: 0,${startStr},${endStr},Default,,0,0,0,,${finalText}\\n`;\n  }\n\n  results.push({\n    json: { assContent, fileName: 'lyrics.ass' },\n    binary: source.binary\n  });\n}\n\nreturn results;"
      },
