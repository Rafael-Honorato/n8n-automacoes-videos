          "jsCode": "const raw = String($json.video_name || '').trim();\nconst parts = raw.split('/');\nconst hasBucket = parts.length > 1 && parts[0] !== '';\nconst source_bucket = hasBucket ? parts[0] : 'lyrics';\nconst source_key = hasBucket ? parts.slice(1).join('/') : raw;\nreturn { json: { ...$json, source_bucket, source_key } };"
