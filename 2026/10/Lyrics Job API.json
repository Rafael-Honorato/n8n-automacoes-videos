      {
        "id": "74ce56a4-5180-4db8-98db-11d704273233",
        "name": "Normalizar Timeline",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          320
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const payload = $input.first().json.body || $input.first().json;\nconst jobId = String(payload.jobId || payload.job_id || '').trim();\nif (!/^[0-9a-zA-Z_-]{1,64}$/.test(jobId)) throw new Error('jobId inválido.');\nconst timeline = payload.timeline || {};\nconst words = Array.isArray(timeline.words) ? timeline.words : [];\nconst lines = Array.isArray(timeline.lines) ? timeline.lines : [];\nconst cleanWords = words\n  .map((word) => ({\n    word: String(word.word || word.text || '').trim(),\n    start: Number(word.start),\n    end: Number(word.end),\n    line: Number.isFinite(Number(word.line)) ? Number(word.line) : null,\n    score: word.score === null || word.score === undefined ? null : Number(word.score),\n    interpolated: Boolean(word.interpolated),\n  }))\n  .filter((word) => word.word && Number.isFinite(word.start) && Number.isFinite(word.end) && word.end > word.start)\n  .sort((a, b) => a.start - b.start);\nif (!cleanWords.length) throw new Error('Timeline sem palavras válidas.');\nconst cleanLines = lines.map((line, index) => ({\n  index,\n  text: String(line.text || ''),\n  start: Number.isFinite(Number(line.start)) ? Number(line.start) : null,\n  end: Number.isFinite(Number(line.end)) ? Number(line.end) : null,\n  word_start: Number.isFinite(Number(line.word_start)) ? Number(line.word_start) : null,\n  word_end: Number.isFinite(Number(line.word_end)) ? Number(line.word_end) : null,\n}));\nif (cleanLines.length) {\n  cleanLines.forEach((line, lineIndex) => {\n    if (line.word_start === null || line.word_end === null) return;\n    for (let index = line.word_start; index < line.word_end && index < cleanWords.length; index += 1) {\n      if (cleanWords[index].line === null) cleanWords[index].line = lineIndex;\n    }\n  });\n}\nconst rawSettings = payload.settings && typeof payload.settings === 'object' ? payload.settings : null;\nlet settings = null;\nif (rawSettings) {\n  const modes = ['none', 'source', 'fixed', 'folder_selected', 'folder_all', 'folder_varied'];\n  const aspects = ['original', '9:16', '4:5', '1:1', '16:9', '4:3'];\n  settings = {\n    templates: Array.isArray(rawSettings.templates)\n      ? rawSettings.templates.map((item) => String(item || '').trim()).filter(Boolean)\n      : [],\n    background_mode: modes.includes(String(rawSettings.background_mode || ''))\n      ? String(rawSettings.background_mode)\n      : 'none',\n    background_keys: Array.isArray(rawSettings.background_keys)\n      ? rawSettings.background_keys.map((item) => String(item || '').trim()).filter(Boolean)\n      : [],\n    output_aspect: aspects.includes(String(rawSettings.output_aspect || ''))\n      ? String(rawSettings.output_aspect)\n      : '9:16',\n    output_quality: String(rawSettings.output_quality || '1080') === '1440' ? '1440' : '1080',\n    fill_mode: String(rawSettings.fill_mode || 'contain') === 'cover' ? 'cover' : 'contain',\n  };\n}\nreturn { json: { jobId, baseRevision: Number(payload.baseRevision || payload.base_revision || 0), settings, timeline: { words: cleanWords, lines: cleanLines } } };"
        }
      },
      {
        "id": "b0317d89-79e0-42b9-ac72-bbfcaab9a576",
        "name": "Baixar Job 1",
        "type": "n8n-nodes-base.s3",
        "typeVersion": 1,
        "position": [
          448,
