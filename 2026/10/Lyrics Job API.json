      {
        "id": "acbf39f8-6b73-411b-94fd-236c73a5abc2",
        "name": "Mesclar Timeline",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          672,
          320
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const input = $input.first();\nconst request = $('Normalizar Timeline').first().json;\nconst text = input.json.jobText;\nif (!text) throw new Error('job.json não encontrado.');\nconst job = JSON.parse(text);\nconst currentRevision = Number(job.timeline?.revision || 0);\nconst conflict = Number(request.baseRevision || 0) !== currentRevision;\nif (conflict) {\n  return { json: { conflict: true, revision: currentRevision, message: 'A timeline mudou em outra aba. Recarregue o job antes de salvar.' } };\n}\nconst revision = currentRevision + 1;\nconst savedAt = new Date().toISOString();\njob.timeline = { revision, saved_at: savedAt, words: request.timeline.words, lines: request.timeline.lines };\nif (request.settings) {\n  job.settings = { ...(job.settings || {}), ...request.settings };\n}\njob.status = 'synced';\njob.updated_at = savedAt;\nconst jobPayload = JSON.stringify(job, null, 2);\nconst timelinePayload = JSON.stringify({ jobId: request.jobId, revision, saved_at: savedAt, words: request.timeline.words, lines: request.timeline.lines }, null, 2);\nreturn {\n  json: { conflict: false, revision, savedAt, jobId: request.jobId, job },\n  binary: {\n    data: { data: Buffer.from(jobPayload, 'utf8').toString('base64'), mimeType: 'application/json', fileName: 'job.json' },\n    timeline: { data: Buffer.from(timelinePayload, 'utf8').toString('base64'), mimeType: 'application/json', fileName: 'timeline.json' },\n  },\n};"
        }
      },
