        "parameters": {
          "resource": "file",
          "operation": "download",
          "bucketName": "lyrics",
          "fileKey": "={{ \"jobs/\" + $(\"Normalizar Timeline\").first().json.jobId + \"/job.json\" }}",
          "binaryPropertyName": "data"
