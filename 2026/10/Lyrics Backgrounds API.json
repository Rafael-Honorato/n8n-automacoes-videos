        "credentials": {
          "s3": {
            "id": "VrwLLnraLOyd7d2l",
            "name": "S3 account SeaweedFS LOCAL"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const items = $input.all().map((item) => item.json);\n\nconst backgrounds = items\n  .map((item) => ({\n    key: item.Key || item.key || '',\n    size: item.Size || item.size || '',\n    lastModified: item.LastModified || item.lastModified || '',\n  }))\n  .filter((item) => item.key && /\\.(mp4|mov|webm|m4v)$/i.test(item.key))\n  .map((item) => ({ ...item, name: item.key.split('/').pop() }))\n  .sort((a, b) => a.name.localeCompare(b.name));\n\nreturn [\n  {\n    json: {\n      count: backgrounds.length,\n      backgrounds,\n    },\n  },\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          112,
          16
        ],
        "id": "1d83d918-c511-43f2-a5e0-3434b195ea63",
        "name": "Preparar Lista"
      },
