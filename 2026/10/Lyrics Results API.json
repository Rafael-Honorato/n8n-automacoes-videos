        "alwaysOutputData": true
      },
      {
        "parameters": {
          "jsCode": "const rows = $input.all().map((item) => item.json);\n\nrows.sort((a, b) =>\n  String(b.createdAt || '').localeCompare(String(a.createdAt || '')),\n);\n\nconst results = rows.slice(0, 200).map((row) => ({\n  id: row.id,\n  execution_id: row.execution_id,\n  execution_url: row.execution_url,\n  run_index: row.run_index,\n  template_file: row.template_file,\n  template_name: row.template_name,\n  background_file: row.background_file,\n  original_filename: row.original_filename,\n  bucket: row.bucket,\n  s3_key: row.s3_key,\n  video_url: row.video_url,\n  file_size_bytes: row.file_size_bytes,\n  duration_seconds: row.duration_seconds,\n  word_count: row.word_count,\n  status: row.status,\n  render_started_at: row.render_started_at,\n  render_finished_at: row.render_finished_at,\n  render_seconds: row.render_seconds,\n  job_started_at: row.job_started_at,\n  job_finished_at: row.job_finished_at,\n  language: row.language,\n  segmentation_mode: row.segmentation_mode,\n  createdAt: row.createdAt,\n}));\n\nreturn [\n  {\n    json: {\n      generatedAt: new Date().toISOString(),\n      count: results.length,\n      results,\n    },\n  },\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
