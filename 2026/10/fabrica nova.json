    {
      "parameters": {
        "jsCode": "const base = $('Reanexar Binário1').item.json;\nconst binary = $('Renderizar com HyperFrames1').item.binary || {};\nconst fileData = binary.data || {};\nconst finishedAt = new Date().toISOString();\nconst startedAt = base.render_started_at || finishedAt;\nconst startedMs = Date.parse(startedAt);\nconst finishedMs = Date.parse(finishedAt);\nconst bucket = base.bucket || 'lyrics';\nconst baseUrl = String(base.s3_public_base_url || 'http://localhost:8333').replace(/\\/+$/, '');\nconst executionId = String($execution.id);\nconst workflowId = String($workflow.id || '');\n\nreturn {\n  json: {\n    execution_id: executionId,\n    execution_url: workflowId\n      ? 'http://localhost:5678/workflow/' + workflowId + '/executions/' + executionId\n      : '',\n    run_index: String(base.run_index ?? ''),\n    template_file: base.template_file || '',\n    template_name: base.template_name || '',\n    original_filename: base.original_filename || '',\n    source_video_key: base.source_video_key || '',\n    bucket,\n    s3_key: base.s3_key || '',\n    video_url: base.s3_key ? baseUrl + '/' + bucket + '/' + base.s3_key : '',\n    file_size_bytes: String(fileData.fileSize ?? ''),\n    duration_seconds: String(base.duration ?? ''),\n    word_count: String(base.word_count ?? ''),\n    status: 'success',\n    render_started_at: startedAt,\n    render_finished_at: finishedAt,\n    render_seconds: Number.isFinite(startedMs)\n      ? ((finishedMs - startedMs) / 1000).toFixed(2)\n      : '',\n    job_started_at: base.job_started_at || '',\n    job_finished_at: finishedAt,\n    language: base.language || '',\n    segmentation_mode: base.segmentation_mode || '',\n  },\n};"
      },
