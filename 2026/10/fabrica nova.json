    {
      "parameters": {
        "jsCode": "const config = $('Configurações (Mock)1').first().json;\nconst templateNames = String(config.template_names || 'lyrics.html')\n  .split(',')\n  .map((name) => name.trim())\n  .filter(Boolean);\n\nconst styles = $('Get row(s)1').all().map((item) => item.json);\nconst style = styles[0] || {};\nconst transcript = $input.first().json;\nconst filename = $('Baixar Vídeo Original1').first().json.fileName || 'video_original.mp4';\n\nconst words = (transcript.words || [])\n  .filter((w) => w && w.word)\n  .map((w) => ({ word: String(w.word), start: Number(w.start), end: Number(w.end) }))\n  .filter((w) => Number.isFinite(w.start) && Number.isFinite(w.end) && w.end > w.start);\n\nif (!words.length) {\n  throw new Error('WhisperX returned no words. Check official_lyrics and segmentation_mode.');\n}\n\nconst lastWord = words[words.length - 1];\nconst duration = Number((lastWord.end + 0.5).toFixed(3));\nconst bucket = 'lyrics';\n\nreturn templateNames.map((templateName, index) => {\n  const templateFile = templateName.toLowerCase().endsWith('.html')\n    ? templateName\n    : templateName + '.html';\n  const slug = templateFile\n    .replace(/\\.html$/i, '')\n    .replace(/[^a-zA-Z0-9._-]+/g, '-');\n  const s3Key = $execution.id + '_' + index + '_' + slug + '.mp4';\n\n  return {\n    json: {\n      run_index: index,\n      total_templates: templateNames.length,\n      template_file: templateFile,\n      template_name: style.name || 'default',\n      template_style: JSON.stringify(style),\n      transcript_data: JSON.stringify(words),\n      original_filename: filename,\n      source_video_key: config.video_key || '',\n      bucket,\n      s3_key: s3Key,\n      duration,\n      word_count: words.length,\n      language: config.language || '',\n      segmentation_mode: config.segmentation_mode || '',\n      job_started_at: config.job_started_at || '',\n      s3_public_base_url: config.s3_public_base_url || 'http://localhost:8333',\n    },\n  };\n});"
      },
