      "id": "4676f2f8-3a5d-417a-aa22-2f37cdb21096",
      "name": "Código — Preparar Linhas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s3Items = $('S3 — Listar SeaweedFS').all().map(function (item) { return item.json || {}; });\nconst rows = $('Tabela — Ler lyric_renders').all().map(function (item) { return item.json || {}; });\nconst byKey = {};\nfor (let i = 0; i < rows.length; i++) {\n  const row = rows[i];\n  const key = String(row.s3_key || '').trim();\n  if (key) byKey[key] = row;\n}\nfunction formatDate(value) {\n  if (!value) return '';\n  const d = new Date(value);\n  if (Number.isNaN(d.getTime())) return String(value);\n  const formatted = new Intl.DateTimeFormat('pt-BR', {\n    timeZone: 'America/Sao_Paulo',\n    day: '2-digit',\n    month: '2-digit',\n    year: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: false\n  }).format(d);\n  return formatted.replace(',', '');\n}\nconst out = [];\nfor (let i = 0; i < s3Items.length; i++) {\n  const item = s3Items[i];\n  const key = String(item.Key || item.key || '').trim();\n  if (!/\\.mp4$/i.test(key)) continue;\n  if (key.startsWith('jobs/') || key.startsWith('videos_background/') || key.startsWith('front/') || key.startsWith('timelines/')) continue;\n  const row = byKey[key] || {};\n  const bucket = String(row.bucket || 'lyrics');\n  const durationSec = Number(row.duration_seconds || 0);\n  const size = row.file_size_bytes || item.Size || item.size || '';\n  const createdAt = row.createdAt || row.render_finished_at || item.LastModified || item.lastModified || '';\n  out.push({ json: {\n    video_id: key.replace(/\\.mp4$/i, ''),\n    video_name: bucket + '/' + key,\n    url: 'http://localhost:8333/' + bucket + '/' + key,\n    status: 'generated',\n    platform: 's3-local',\n    created_at: formatDate(createdAt),\n    file_size: String(size || ''),\n    duration: durationSec > 0 ? (durationSec / 60).toFixed(2) : ''\n  } });\n}\nreturn out;"
      }
    },
