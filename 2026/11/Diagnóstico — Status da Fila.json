      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(function (item) { return item.json || {}; });\nconst counts = {};\nfor (let i = 0; i < rows.length; i++) {\n  const s = String(rows[i].status || '').trim() || '(vazio)';\n  counts[s] = (counts[s] || 0) + 1;\n}\nconst uploaded = rows.filter(function (r) { return String(r.status || '') === 'uploaded'; });\nconst errors = rows.filter(function (r) { return String(r.status || '') === 'error'; }).map(function (r) {\n  return { video_id: r.video_id, video_name: r.video_name, error: r.error, file_size: r.file_size };\n});\nreturn [{ json: { total: rows.length, counts: counts, uploaded_sample: uploaded.slice(-3), errors: errors } }];"
      }
    }
